{
    admin off
    auto_https off
    persist_config off
}

:8080 {
    route {
        @hooks path /hooks /hooks/*
        respond @hooks 403

        # Docker masquerades cross-bridge ingress to this internal gateway.
        # The host firewall restricts the original source to the connector
        # before NAT; host-local processes remain trusted. Keep that filter.
        # cloudflared must validate Access JWTs ("Protect with Access").
        @cloudflare {
            host {$MAUS_HTTPS_HOST:disabled.invalid}
            remote_ip 172.30.50.1
        }
        handle @cloudflare {
            reverse_proxy 127.0.0.1:8799 {
                header_up -Forwarded
                header_up X-Forwarded-Proto https
                header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
                flush_interval -1
            }
        }

        # SSH forwards to the container IP. Requests originate at the
        # internal bridge gateway; retain HTTP cookies for localhost.
        @ssh {
            host localhost 127.0.0.1
            remote_ip 127.0.0.1 ::1 172.30.50.1
        }
        handle @ssh {
            reverse_proxy 127.0.0.1:8799 {
                header_up -Forwarded
                header_up X-Forwarded-Proto http
                header_up X-Forwarded-For {http.request.remote.host}
                flush_interval -1
            }
        }

        respond 403
    }
}
